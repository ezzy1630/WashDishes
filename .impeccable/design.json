  "narrative": {
    "overview": "Dish Watch uses a restrained graphite interface with real camera evidence as its dominant visual material. Mona Sans, compact controls, thin borders and quiet metadata support short kitchen-review sessions. The interface keeps uncertain observations visibly distinct from confirmed responsibility.\n\nThis record covers the implemented incident feed and case/review page, with shared controls from the static app. It records the built palette rather than the slightly lighter range in the direction brief. Surface composition remains in `.impeccable/surfaces/wash-dishes-static-index-html.md`; product rules remain in `PRODUCT.md`.\n",
    "keyCharacteristics": [
      "Real full-scene evidence before attribution.",
      "Graphite layers, restrained borders and compact native controls.",
      "Readable muted metadata and explicit unknown states.",
      "A responsive evidence column beside one review form."
    ],
    "rules": [
      {
        "name": "The Readable Metadata Rule",
        "body": "Incident hints, timestamps, missing-media messages and inactive status tabs use the scoped muted text color. Do not inherit the legacy root muted value into these surfaces.",
        "section": "colors"
      },
      {
        "name": "The Evidence Boundary Rule",
        "body": "Keep missing stages, uncertain attribution and washing-unknown outcomes explicit. A photograph, a nearby person or a disappearing dish is not a visual substitute for confirmed responsibility or washing.",
        "section": "components"
      }
    ],
    "dos": [
      "Do keep real evidence full-scene, uncropped and accompanied by its limits.",
      "Do use the scoped readable muted token for incident metadata and field hints.",
      "Do pair semantic state color with explicit text.",
      "Do retain native labeled controls, visible focus and reduced-motion behavior.",
      "Do stack evidence before review on narrow screens."
    ],
    "donts": [
      "Don't invent or substitute imagery for missing household evidence.",
      "Don't turn unknown observations into named responsibility or confirmed washing.",
      "Don't promote the legacy root muted color or ornamental eyebrows into new surfaces.",
